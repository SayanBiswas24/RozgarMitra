# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# cp .env.example .env

# ── BHASHINI Configuration ───────────────────────────────────────────────────
LANGUAGE_PROVIDER=bhashini
BHASHINI_ENABLED=true
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_API_KEY=

BHASHINI_ALD_SERVICE_ID=bhashini/iitmandi/audio-lang-detection/gpu
BHASHINI_ASR_SERVICE_ID=bhashini/bodhan/asr-transcribe-flex
BHASHINI_NMT_SERVICE_ID=bhashini/iiith/nmt-all
BHASHINI_TRANSLITERATION_SERVICE_ID=ai4bharat/indicxlit--cpu-fsv2
BHASHINI_OCR_SERVICE_ID=bhashini/iiith-bhasha-ocr

# ── Language-Specific TTS Services ───────────────────────────────────────────
BHASHINI_TTS_SERVICE_ID_HI=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_EN=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_BHO=Bhashini/IISC/TTS
BHASHINI_TTS_SERVICE_ID_BN=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_MAI=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_SAT=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_TA=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_TE=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_KN=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_ML=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_MR=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_GU=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_PA=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_OR=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_AS=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_UR=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_KOK=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_MNI=Bhashini/IITM/TTS
BHASHINI_TTS_SERVICE_ID_NE=Bhashini/IITM/TTS

# ── LLM Configuration ────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
