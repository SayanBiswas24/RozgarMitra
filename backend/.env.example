PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rojgar_mitra

# JWT Configuration
JWT_SECRET=your_production_jwt_secret_min_32_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Hashing & Security
BCRYPT_SALT_ROUNDS=12
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_MAX_GLOBAL=200

# Lockout Policy
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MS=900000
PASSWORD_RESET_EXPIRES_MS=900000
